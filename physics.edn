;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a diagnostic robot (vibration, wear,
;; calibration-drift sensing) inspects rental tools and machinery before they
;; re-enter the rental pool. Its physical work: lifting a returned tool onto
;; the test bench, a proof-load pull on a worn steel pin from a rental jack
;; stand, and the run-in test that heats a power tool's motor winding.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-unspsc-27"
 :cases
 [{:id :returned-tool-to-bench
   :kind :manipulator
   :procedure "arm lifts a returned power tool (drill up to demolition breaker) from the return cart onto the inspection bench"
   :params {:l1-m 0.60 :l2-m 0.50 :m1-kg 10.0 :m2-kg 6.0
            :from [0.70 0.00] :to [0.35 0.60] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [2.0 5.0 10.0 15.0 20.0 30.0]}
   :quantity :peak-tau1-nm
   :limit {:max 180.0 :basis "estimate: continuous shoulder torque of a 20 kg-payload-class inspection-cell arm"}
   :boundary {:lo 0.5 :hi 60.0}}
  {:id :jack-stand-pin-proof-pull
   :kind :material
   :procedure "proof-load pull on the S355 steel locking pin of a rental jack stand, worn from 20 mm down to 16 mm diameter"
   :params {:length-m 0.10 :youngs-modulus-pa 210.0e9 :yield-stress-pa 355.0e6
            :hardening-pa 1.0e9 :density-kg-m3 7850.0 :max-force-n 150000.0}
   :sweep {:param :area-m2 :values [3.14e-4 2.835e-4 2.545e-4 2.27e-4 2.01e-4]}
   :quantity :yield-force-n
   :limit {:min 80000.0 :basis "estimate: rated stand load times a safety factor; the 355 MPa yield is the EN 10025-2 S355 nominal for thin sections"}}
  {:id :motor-run-in-heating
   :kind :thermal
   :procedure "30-minute run-in test of a rental power tool: copper losses heat the stator winding, the fan-cooled housing sheds it to shop air (half thickness, hot-spot at the mid-plane)"
   :params {:thickness-m 0.010 :conductivity-w-mk 2.0 :density-kg-m3 5000.0 :specific-heat-j-kgk 600.0
            :t0-c 30.0 :t-hot-c 30.0 :h-front-w-m2k 30.0 :h-back-w-m2k 0.0 :t-back-ambient-c 30.0
            :threshold-c 130.0 :duration-s 1800.0 :nodes 11}
   :sweep {:param :q-gen-w-m3 :values [100000.0 200000.0 300000.0 500000.0 700000.0]}
   :quantity :peak-back-c
   :limit {:max 130.0 :basis "estimate: assumes class B winding insulation, i.e. IEC 60085 thermal class 130 (B); the tool's actual insulation class is not yet recorded"}
   :boundary {:lo 10000.0 :hi 1500000.0}}]}
